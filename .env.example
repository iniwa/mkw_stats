POSTGRES_DB=mkw_stats
POSTGRES_USER=mkw
POSTGRES_PASSWORD=changeme

# On Raspberry Pi, set to /home/iniwa/docker/mkw-stats
DATA_DIR=./data

# Used by alembic and seed script when run outside Docker.
# The backend container reads DATABASE_URL from docker-compose.yml automatically.
DATABASE_URL=postgresql+psycopg://mkw:changeme@localhost:5432/mkw_stats
